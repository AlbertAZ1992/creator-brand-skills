{
  "name": "@creator-brand-skills/logo-to-clay",
  "version": "0.4.0",
  "description": "Transform a logo into a claymation-style 3D render with procedural mesh generation",
  "license": "MIT",
  "files": [
    "dist/src",
    "SKILL.md",
    "agents",
    "docs",
    "examples",
    "schemas"
  ],
  "type": "module",
  "main": "./dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "scripts": {
    "build": "tsc",
    "examples": "tsx scripts/generate-examples.ts",
    "prepack": "npm run build",
    "eval": "tsx eval/run.ts",
    "format:check": "oxfmt --check src tests eval scripts",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm run build && npm test && npm run eval && npm run verify:deliverables",
    "verify:deliverables": "tsx scripts/eval-deliverables.ts",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests eval scripts",
    "format": "oxfmt"
  },
  "dependencies": {
    "sharp": "^0.35.4",
    "three": "^0.170.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/three": "^0.185.4",
    "oxfmt": "^0.15.0",
    "oxlint": "^0.15.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
