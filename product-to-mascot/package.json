{
  "name": "@creator-brand-skills/product-to-mascot",
  "version": "0.1.0",
  "description": "Generate a brand mascot concept from product semantics",
  "type": "module",
  "license": "MIT",
  "main": "./dist/src/index.js",
  "exports": {
    ".": "./dist/src/index.js"
  },
  "files": [
    "THIRD_PARTY_NOTICES.md",
    "dist/src",
    "SKILL.md",
    "agents",
    "examples",
    "schemas",
    "scripts"
  ],
  "scripts": {
    "build": "tsc",
    "examples": "bash examples/generate-showcase.sh",
    "prepack": "npm run build",
    "eval": "tsx eval/run.ts",
    "format:check": "oxfmt --check src tests",
    "verify": "npm run lint && npm run format:check && npm run typecheck && npm test && npm run eval && npm run verify:deliverables",
    "verify:deliverables": "sh scripts/eval-mascot-reference-set.sh",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests",
    "format": "oxfmt"
  },
  "devDependencies": {
    "oxfmt": "^0.15.0",
    "oxlint": "^0.15.0",
    "tsx": "^4.23.12",
    "typescript": "^5.7.0",
    "vitest": "^3.0.0"
  }
}
